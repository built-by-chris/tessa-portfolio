---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  socialImage?: string;
  socialImageAlt?: string;
}

const {
  title = 'Tessa Rouse',
  description = 'Professional portfolio of Tessa Rouse, featuring public administration, policy analysis, research, and public service work.',
  noindex = false,
  socialImage = '/images/tessa-social-card-government.png',
  socialImageAlt = 'Tessa Rouse — Public Administration & Policy. Public problems deserve careful analysis.',
} = Astro.props;

const pageTitle = title === 'Tessa Rouse' ? 'Tessa Rouse | Public Administration & Policy' : `${title} | Tessa Rouse`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? 'https://tessarouse.me');
const socialImageURL = new URL(socialImage, Astro.site ?? 'https://tessarouse.me');
const isHomepage = Astro.url.pathname === '/';
const homepageSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': 'https://tessarouse.me/#website',
      url: 'https://tessarouse.me/',
      name: 'Tessa Rouse',
      alternateName: 'Tessa Rouse Portfolio',
      description:
        'Professional portfolio of Tessa Rouse, featuring public administration, policy analysis, research, and public service work.',
      publisher: {
        '@id': 'https://tessarouse.me/#person',
      },
    },
    {
      '@type': 'Person',
      '@id': 'https://tessarouse.me/#person',
      name: 'Tessa Rouse',
      url: 'https://tessarouse.me/',
      jobTitle: 'Master of Public Administration Candidate',
      description:
        'Public administration and policy professional focused on policy analysis, governance, research, and public service.',
      sameAs: ['https://www.linkedin.com/in/tessa-rouse'],
      knowsAbout: [
        'Public administration',
        'Policy analysis',
        'Governance',
        'Public service',
        'Research',
        'GIS and data analysis',
      ],
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#f8f6fa" />
    <meta name="color-scheme" content="light" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=7" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=5" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="Tessa Rouse" />
    <meta property="og:image" content={socialImageURL} />
    <meta property="og:image:secure_url" content={socialImageURL} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageURL} />
    <meta name="twitter:image:alt" content={socialImageAlt} />

    {
      isHomepage && (
        <script type="application/ld+json" set:html={JSON.stringify(homepageSchema)} />
      )
    }

    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Header />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
