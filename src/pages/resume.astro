---
import BaseLayout from '../layouts/BaseLayout.astro';

const skills = [
  'Policy & regulatory research',
  'Policy and analytical writing',
  'Public administration',
  'Data collection & quality assurance',
  'GIS-based database support',
  'Risk management & compliance',
  'Process documentation',
  'Stakeholder communication',
  'Incident & emergency coordination',
  'Operational readiness',
];

const experience = [
  {
    role: 'Emergency Response Coordinator',
    context: 'GIS / Data Quality / Risk Management Support',
    organization: 'Adecco Group',
    dates: 'Dec. 2023 – Apr. 2024',
    highlights: [
      'Supported GIS-based mapping and compliance databases used in risk-management operations.',
      'Managed reporting and documentation workflows tied to regulatory compliance and operational readiness.',
      'Conducted data collection, quality assurance, auditing, and discrepancy resolution for daily operations and audit traceability.',
      'Co-developed a SharePoint resource to improve recurring workflow consistency and team efficiency.',
    ],
  },
  {
    role: 'Security & Operational Support',
    context: 'Multiple client and contractor environments',
    organization: 'Signal Security · American Guard Services · Allied Universal · U.S. Security Associates',
    dates: '2015 – 2023',
    highlights: [
      'Worked across aviation, financial, retail, cruise, and facility environments supporting access control, continuity, incident response, and policy compliance.',
      'Coordinated with law enforcement, EMS, vendors, employees, and site leadership during routine and emergency operations.',
      'Maintained incident documentation, monitored CCTV and access systems, and adapted to changing procedures across client sites.',
    ],
  },
  {
    role: 'Network Switch Systems Operator (25F)',
    context: 'Signal Corps',
    organization: 'U.S. Army',
    dates: 'June 2011 – June 2015',
    highlights: [
      'Supported communications readiness, equipment accountability, team operations, and emergency preparedness.',
      'Maintained accountability for approximately $2 million in communications equipment.',
      'Supported early-warning and site-security operations during an overseas deployment at a Patriot missile site.',
    ],
  },
];
---

<BaseLayout title="Résumé" description="Professional experience, education, and analytical skills for Tessa Rouse.">
  <section class="page-section resume-hero">
    <div class="container hero-grid">
      <div>
        <p class="eyebrow">Professional background</p>
        <h1>Résumé</h1>
        <p class="page-tagline">Systems, operations, analysis, and public service.</p>
      </div>
      <div>
        <p class="lede">
          MPA candidate, Cum Laude political science graduate, and U.S. Army veteran
          transitioning experience in operations, data quality, compliance, and emergency
          coordination into policy and public-administration analysis.
        </p>
        <div class="hero-links">
          <a class="button" href="/files/tessa-rouse-resume.pdf" download>Download résumé (PDF)</a>
          <a class="text-link" href="/writing">View selected work</a>
          <a class="text-link" href="https://www.linkedin.com/in/tessa-rouse" rel="me">LinkedIn</a>
        </div>
      </div>
    </div>
  </section>

  <section class="page-section">
    <div class="container two-column">
      <div>
        <p class="eyebrow">Education</p>
        <h2>Academic foundation.</h2>
      </div>

      <div>
        <div class="education-list">
          <article>
            <div class="entry-top">
              <div>
                <h3>Master of Public Administration</h3>
                <p>Arizona State University</p>
              </div>
              <span>Expected 2027</span>
            </div>
            <p class="entry-copy">
              Graduate study in policy analysis, governance, ethics, organizational management,
              research methods, statistics, implementation, and public administration.
            </p>
          </article>

          <article>
            <div class="entry-top">
              <div>
                <h3>B.A., Political Science</h3>
                <p>American Military University</p>
              </div>
              <span>Feb. 2026</span>
            </div>
            <p class="entry-copy">
              Concentration in American Government. Graduated Cum Laude with a 3.5 GPA.
            </p>
          </article>
        </div>

        <div class="education-verification">
          <p>Additional institution-verified academic honors are available through Merit.</p>
          <a
            class="text-link"
            href="https://meritpages.com/tessajrouse"
            target="_blank"
            rel="noopener noreferrer"
          >
            Academic honors on Merit
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="page-section experience-section">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Experience</p>
          <h2>Selected professional history.</h2>
        </div>
        <p>
          The web résumé emphasizes the experience most relevant to policy, program,
          administrative, and operations-oriented roles.
        </p>
      </div>

      <div class="experience-list">
        {experience.map((item) => (
          <article class="experience-item">
            <div class="experience-heading">
              <div>
                <h3>{item.role}</h3>
                <p>{item.context}</p>
              </div>
              <div class="experience-meta">
                <strong>{item.organization}</strong>
                <span>{item.dates}</span>
              </div>
            </div>
            <ul>
              {item.highlights.map((highlight) => <li>{highlight}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="page-section">
    <div class="container two-column">
      <div>
        <p class="eyebrow">Capabilities</p>
        <h2>Skills carried across roles.</h2>
      </div>
      <ul class="skill-list">
        {skills.map((skill) => <li>{skill}</li>)}
      </ul>
    </div>
  </section>

  <section class="page-section research-section">
    <div class="container research-grid">
      <div>
        <p class="eyebrow">Research & portfolio</p>
        <h2>Work that shows the analysis.</h2>
      </div>
      <div>
        <p class="lede">
          The résumé tells the chronology. The portfolio shows how I approach public problems.
        </p>
        <p>
          Selected work includes analysis of veterans policy and administrative capacity,
          organizational change in VA care coordination, and long-form research on health policy,
          federalism, and constitutional government.
        </p>
        <a class="text-link" href="/writing">Explore the writing portfolio</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .resume-hero {
    padding-top: clamp(5rem, 10vw, 9rem);
  }

  .hero-grid,
  .two-column,
  .research-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(2.5rem, 8vw, 8rem);
    align-items: end;
  }

  .page-tagline {
    margin: 0.8rem 0 0;
    color: var(--color-accent);
    font-size: 0.9rem;
    font-weight: 750;
  }

  .hero-links {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2rem;
  }

  .two-column {
    align-items: start;
  }

  .two-column h2,
  .research-grid h2 {
    max-width: 10ch;
  }

  .education-list {
    border-top: 1px solid var(--color-border-strong);
  }

  .education-list article {
    padding: 1.6rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .education-verification {
    margin-top: 1.25rem;
  }

  .education-verification p {
    margin: 0 0 0.55rem;
    color: var(--color-muted);
    font-size: 0.9rem;
  }

  .entry-top,
  .experience-heading {
    display: flex;
    justify-content: space-between;
    gap: 2rem;
  }

  .entry-top h3,
  .experience-heading h3 {
    margin-bottom: 0.25rem;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 1.35rem;
  }

  .entry-top p,
  .experience-heading p {
    margin: 0;
    color: var(--color-muted);
  }

  .entry-top > span {
    flex: 0 0 auto;
    color: var(--color-muted);
    font-size: 0.82rem;
    font-weight: 750;
  }

  .entry-copy {
    margin-bottom: 0;
    color: var(--color-muted);
  }

  .experience-section,
  .research-section {
    background: color-mix(in srgb, var(--color-bg-deep) 58%, transparent);
  }

  .section-heading {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: end;
    gap: 3rem;
    margin-bottom: 2.5rem;
  }

  .section-heading h2 {
    max-width: 11ch;
    margin-bottom: 0;
  }

  .section-heading > p {
    margin: 0;
    color: var(--color-muted);
  }

  .experience-list {
    border-top: 1px solid var(--color-border-strong);
  }

  .experience-item {
    padding: 2rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .experience-meta {
    display: grid;
    justify-items: end;
    align-content: start;
    gap: 0.15rem;
    text-align: right;
  }

  .experience-meta strong {
    font-size: 0.88rem;
  }

  .experience-meta span {
    color: var(--color-muted);
    font-size: 0.8rem;
  }

  .experience-item ul {
    max-width: 52rem;
    margin: 1.25rem 0 0;
    padding-left: 1.2rem;
    color: var(--color-muted);
  }

  .experience-item li + li {
    margin-top: 0.55rem;
  }

  .skill-list {
    display: flex;
    flex-wrap: wrap;
    align-content: start;
    gap: 0.55rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .skill-list li {
    padding: 0.55rem 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-surface);
    color: var(--color-muted);
    font-size: 0.88rem;
    font-weight: 700;
  }

  .research-grid p:not(.lede) {
    color: var(--color-muted);
  }

  @media (max-width: 820px) {
    .hero-grid,
    .two-column,
    .research-grid,
    .section-heading {
      grid-template-columns: 1fr;
      align-items: start;
      gap: 1.5rem;
    }

    .entry-top,
    .experience-heading {
      flex-direction: column;
      gap: 0.65rem;
    }

    .experience-meta {
      justify-items: start;
      text-align: left;
    }
  }
</style>
