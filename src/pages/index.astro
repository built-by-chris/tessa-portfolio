---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import WorkCard from '../components/WorkCard.astro';
import ProofOfWork from '../components/ProofOfWork.astro';

const writing = await getCollection('writing', ({ data }) => data.public && data.featured);
const projects = await getCollection('projects', ({ data }) => data.public && data.featured);

const featuredWork = [
  ...writing.map((entry) => ({
    href: `/writing/${entry.id}`,
    eyebrow: entry.data.category,
    title: entry.data.title,
    summary: entry.data.summary,
    date: entry.data.date,
    tags: entry.data.tags,
  })),
  ...projects.map((entry) => ({
    href: `/projects/${entry.id}`,
    eyebrow: entry.data.format ?? 'Project',
    title: entry.data.title,
    summary: entry.data.summary,
    date: entry.data.date,
    tags: entry.data.tags,
  })),
]
  .sort((a, b) => (b.date?.valueOf() ?? 0) - (a.date?.valueOf() ?? 0))
  .slice(0, 3);

const formatDate = (date?: Date) =>
  date ? new Intl.DateTimeFormat('en-US', { year: 'numeric', month: 'short' }).format(date) : undefined;
---

<BaseLayout
  title="Tessa Rouse"
  description="Professional portfolio of Tessa Rouse, featuring public administration, policy analysis, research, and public service work."
>
  <section class="page-section hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Public administration · policy · research</p>
        <h1>Public problems deserve careful analysis.</h1>
        <p class="lede">
          I'm Tessa Rouse, an MPA candidate at Arizona State University building a body of
          work around policy analysis, governance, research, and public service.
        </p>
        <div class="actions">
          <a class="button" href="/writing">Explore selected work</a>
          <a class="text-link" href="/about">More about me</a>
        </div>
      </div>

      <aside class="profile-card" aria-label="Professional snapshot">
        <p class="profile-label">At a glance</p>
        <dl>
          <div>
            <dt>Graduate study</dt>
            <dd>MPA · Arizona State University</dd>
          </div>
          <div>
            <dt>Foundation</dt>
            <dd>B.A. Political Science · Cum Laude</dd>
          </div>
          <div>
            <dt>Background</dt>
            <dd>U.S. Army veteran</dd>
          </div>
        </dl>
      </aside>
    </div>
  </section>

  <section class="page-section">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Areas of focus</p>
          <h2>Where the work is headed.</h2>
        </div>
        <p>
          The portfolio is organized around the questions, methods, and public institutions
          that define my graduate work and professional direction.
        </p>
      </div>

      <div class="focus-grid">
        <article class="focus-card">
          <span aria-hidden="true">01</span>
          <h3>Policy analysis</h3>
          <p>Evaluating policy design, implementation, evidence, tradeoffs, and institutional outcomes.</p>
        </article>
        <article class="focus-card">
          <span aria-hidden="true">02</span>
          <h3>Public administration</h3>
          <p>Examining governance, ethics, organizations, management, and the practice of public service.</p>
        </article>
        <article class="focus-card">
          <span aria-hidden="true">03</span>
          <h3>Research & writing</h3>
          <p>Turning complex public problems into clear, structured analysis for academic and professional audiences.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="page-section proof-section" aria-labelledby="proof-heading">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Methods in practice</p>
          <h2 id="proof-heading">See the work behind the skills.</h2>
        </div>
        <p>
          Selected graduate work shows how I frame public problems, assess evidence,
          and develop proposals for institutional improvement. These are academic
          analyses and designs, not claims of completed field implementations.
        </p>
      </div>
      <ProofOfWork />
    </div>
  </section>

  <section class="page-section work-preview">
    <div class="container">
      <div class="work-intro">
        <div>
          <p class="eyebrow">Selected work</p>
          <h2>Selected work across policy, research, and public administration.</h2>
        </div>
        <div class="work-copy">
          <p class="lede">
            Three pieces that show the range of my work across policy analysis,
            organizational change, and long-form research.
          </p>
          <div class="collection-links">
            <a class="text-link" href="/writing">Writing</a>
            <a class="text-link" href="/projects">Projects</a>
          </div>
        </div>
      </div>

      <div class="featured-list">
        {featuredWork.map((entry) => (
          <WorkCard
            href={entry.href}
            eyebrow={entry.eyebrow}
            title={entry.title}
            summary={entry.summary}
            meta={formatDate(entry.date)}
            tags={entry.tags}
          />
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-top: clamp(5rem, 11vw, 9.5rem);
    padding-bottom: clamp(4.5rem, 10vw, 8rem);
  }

  .hero::after {
    content: '';
    position: absolute;
    width: min(38rem, 70vw);
    aspect-ratio: 1;
    right: -12rem;
    top: -14rem;
    z-index: -1;
    border: 1px solid var(--color-border);
    border-radius: 50%;
    box-shadow:
      0 0 0 4rem rgba(255, 255, 255, 0.2),
      0 0 0 8rem rgba(112, 64, 149, 0.025);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(17rem, 0.65fr);
    align-items: end;
    gap: clamp(3rem, 8vw, 8rem);
  }

  .hero-copy h1 {
    max-width: 10ch;
  }

  @media (min-width: 821px) {
    .hero-copy h1 {
      font-size: clamp(2.75rem, 5.8vw, 4.35rem);
    }
  }

  .hero-copy .lede {
    max-width: 43rem;
  }

  .actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.1rem;
    margin-top: 2rem;
  }

  .profile-card {
    padding: 1.5rem;
    border: 1px solid var(--color-border-strong);
    border-radius: 1.25rem;
    background: color-mix(in srgb, var(--color-surface) 88%, transparent);
    box-shadow: var(--shadow-soft);
  }

  .profile-label {
    margin: 0 0 1rem;
    color: var(--color-accent);
    font-size: 0.74rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  dl {
    margin: 0;
  }

  dl div {
    display: grid;
    grid-template-columns: 4.5rem 1fr;
    gap: 1rem;
    padding: 0.9rem 0;
    border-top: 1px solid var(--color-border);
  }

  dt {
    color: var(--color-muted);
    font-size: 0.8rem;
    font-weight: 700;
  }

  dd {
    margin: 0;
    font-size: 0.92rem;
    font-weight: 700;
  }

  .section-heading {
    max-width: 46rem;
    margin-bottom: 2.5rem;
  }

  .section-heading h2 {
    margin-bottom: 1rem;
  }

  .section-heading > p {
    margin: 0;
    color: var(--color-muted);
  }

  .focus-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid var(--color-border-strong);
  }

  .focus-card {
    padding: 1.7rem 1.5rem 0 0;
  }

  .focus-card + .focus-card {
    padding-left: 1.5rem;
    border-left: 1px solid var(--color-border);
  }

  .focus-card span {
    display: inline-block;
    margin-bottom: 2.4rem;
    color: var(--color-accent);
    font-family: Georgia, "Times New Roman", serif;
    font-size: 0.95rem;
  }

  .focus-card h3 {
    font-size: 1.55rem;
  }

  .focus-card p {
    margin-bottom: 0;
    color: var(--color-muted);
  }

  .work-preview {
    background: color-mix(in srgb, var(--color-bg-deep) 62%, transparent);
  }

  .work-intro {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: clamp(3rem, 8vw, 8rem);
    align-items: end;
    margin-bottom: 3rem;
  }

  .work-intro h2 {
    max-width: 10ch;
    margin-bottom: 0;
  }

  .work-copy p:first-child {
    margin-top: 0;
  }

  .collection-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    margin-top: 1.25rem;
  }

  .featured-list {
    border-bottom: 1px solid var(--color-border-strong);
  }

  @media (max-width: 820px) {
    .hero-grid,
    .work-intro {
      grid-template-columns: 1fr;
    }

    .hero-grid {
      align-items: start;
      gap: 3rem;
    }

    .profile-card {
      width: min(100%, 30rem);
    }

    .focus-grid {
      grid-template-columns: 1fr;
    }

    .focus-card,
    .focus-card + .focus-card {
      padding: 1.5rem 0;
      border-left: 0;
      border-bottom: 1px solid var(--color-border);
    }

    .focus-card span {
      margin-bottom: 1rem;
    }
  }
</style>
