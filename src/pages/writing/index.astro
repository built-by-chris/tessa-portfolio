---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import WorkCard from '../../components/WorkCard.astro';

const writing = (await getCollection('writing', ({ data }) => data.public))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat('en-US', { year: 'numeric', month: 'short' }).format(date);
---

<BaseLayout
  title="Writing"
  description="Selected policy analysis, academic research, and public writing by Tessa Rouse."
>
  <section class="page-section page-intro">
    <div class="container intro-grid">
      <div>
        <p class="eyebrow">Writing</p>
        <h1>Selected work.</h1>
      </div>
      <p class="lede">
        A curated collection of policy analysis, research, and academic work adapted
        for public presentation. Original work is linked where available.
      </p>
    </div>
  </section>

  <section class="page-section collection-section">
    <div class="container">
      {writing.length > 0 ? (
        <div class="collection-list">
          {writing.map((entry) => (
            <WorkCard
              href={`/writing/${entry.id}`}
              eyebrow={entry.data.category}
              title={entry.data.title}
              summary={entry.data.summary}
              meta={formatDate(entry.data.date)}
              tags={entry.data.tags}
            />
          ))}
        </div>
      ) : (
        <div class="empty-state">
          <p class="eyebrow">Collection in progress</p>
          <h2>The first pieces are being prepared.</h2>
          <p>
            Work will appear here only after it has been selected and reviewed for public
            presentation. The goal is a focused portfolio—not a complete archive of coursework.
          </p>
        </div>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .page-intro {
    padding-bottom: clamp(3rem, 6vw, 5rem);
  }

  .intro-grid {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    align-items: end;
    gap: clamp(2rem, 7vw, 7rem);
  }

  .intro-grid h1,
  .intro-grid .lede {
    margin-bottom: 0;
  }

  .collection-section {
    padding-top: 0;
    border-top: 0;
  }

  .collection-list {
    border-bottom: 1px solid var(--color-border-strong);
  }

  .empty-state {
    max-width: 46rem;
    padding: clamp(2rem, 5vw, 4rem);
    border: 1px solid var(--color-border);
    border-radius: 1.25rem;
    background: var(--color-surface);
    box-shadow: var(--shadow-soft);
  }

  .empty-state h2 {
    max-width: 12ch;
  }

  .empty-state p:last-child {
    margin-bottom: 0;
    color: var(--color-muted);
  }

  @media (max-width: 760px) {
    .intro-grid {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
  }
</style>
