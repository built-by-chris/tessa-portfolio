---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const entries = await getCollection('writing', ({ data }) => data.public);
  return entries.map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const date = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(entry.data.date);
---

<BaseLayout title={entry.data.title} description={entry.data.summary}>
  <article>
    <header class="page-section article-header">
      <div class="container article-grid">
        <div>
          <a class="back-link" href="/writing">← Writing</a>
          <p class="eyebrow">{entry.data.category}</p>
          <h1>{entry.data.title}</h1>
        </div>
        <div class="article-summary">
          <p class="lede">{entry.data.summary}</p>
          <div class="article-meta">
            <span>{date}</span>
            {entry.data.tags.length > 0 && <span>{entry.data.tags.join(' · ')}</span>}
          </div>
        </div>
      </div>
    </header>

    <section class="page-section article-body">
      <div class="container">
        <div class="prose">
          <Content />
        </div>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .article-header {
    padding-bottom: clamp(3rem, 6vw, 5rem);
  }

  .article-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(18rem, 0.75fr);
    align-items: end;
    gap: clamp(2rem, 7vw, 7rem);
  }

  .back-link {
    display: inline-block;
    margin-bottom: 2rem;
    color: var(--color-muted);
    font-size: 0.88rem;
    font-weight: 750;
    text-decoration: none;
  }

  .article-header h1 {
    max-width: 12ch;
    font-size: clamp(2.8rem, 7vw, 5.8rem);
  }

  .article-summary {
    padding-bottom: 0.5rem;
  }

  .article-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1rem;
    margin-top: 1.5rem;
    color: var(--color-muted);
    font-size: 0.82rem;
    font-weight: 650;
  }

  .article-body {
    background: var(--color-surface);
  }

  .prose {
    width: min(100%, 46rem);
    margin-inline: auto;
    font-size: 1.06rem;
  }

  .prose :global(h2),
  .prose :global(h3) {
    margin-top: 2.5em;
  }

  .prose :global(h2) {
    font-size: clamp(1.8rem, 3.5vw, 2.5rem);
  }

  .prose :global(p),
  .prose :global(li) {
    color: #352d3a;
  }

  .prose :global(blockquote) {
    margin: 2rem 0;
    padding-left: 1.25rem;
    border-left: 3px solid var(--color-accent);
    color: var(--color-muted);
  }

  @media (max-width: 760px) {
    .article-grid {
      grid-template-columns: 1fr;
      align-items: start;
    }
  }
</style>
