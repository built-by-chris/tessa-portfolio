---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CaseStudyVisual from '../../components/CaseStudyVisual.astro';

export async function getStaticPaths() {
  const entries = await getCollection('writing', ({ data }) => data.public);
  return entries.map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const date = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(entry.data.date);

---

<BaseLayout title={entry.data.title} description={entry.data.summary}>
  <article>
    <header class="page-section article-header">
      <div class="container article-grid">
        <div>
          <a class="back-link" href="/writing">← Writing</a>
          <p class="eyebrow">{entry.data.category}</p>
          <h1>{entry.data.title}</h1>
        </div>
        <div class="article-summary">
          <p class="lede">{entry.data.summary}</p>

          <dl class="context-list">
            <div>
              <dt>Date</dt>
              <dd>{date}</dd>
            </div>
            {entry.data.format && (
              <div>
                <dt>Format</dt>
                <dd>{entry.data.format}</dd>
              </div>
            )}
            {entry.data.institution && (
              <div>
                <dt>Institution</dt>
                <dd>{entry.data.institution}</dd>
              </div>
            )}
            {entry.data.course && (
              <div>
                <dt>Course</dt>
                <dd>{entry.data.course}</dd>
              </div>
            )}
          </dl>

          {entry.data.tags.length > 0 && (
            <ul class="tag-list" aria-label="Topics">
              {entry.data.tags.map((tag) => <li>{tag}</li>)}
            </ul>
          )}
        </div>
      </div>
    </header>

    <section class="page-section article-body">
      <div class="container">
        {entry.id === 'pact-act-public-administration-analysis' && <CaseStudyVisual variant="pact" />}
        {entry.id === 'single-payer-american-dream' && <CaseStudyVisual variant="capstone" />}
        <div class="prose">
          <Content />
        </div>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .article-header {
    padding-bottom: clamp(3rem, 6vw, 5rem);
  }

  .article-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(18rem, 0.75fr);
    align-items: end;
    gap: clamp(2rem, 7vw, 7rem);
  }

  .back-link {
    display: inline-block;
    margin-bottom: 2rem;
    color: var(--color-muted);
    font-size: 0.88rem;
    font-weight: 750;
    text-decoration: none;
  }

  .article-header h1 {
    max-width: 12ch;
    font-size: clamp(2.5rem, 5.8vw, 4.8rem);
  }

  .article-summary {
    padding-bottom: 0.5rem;
  }

  .context-list {
    margin: 1.75rem 0 0;
    border-top: 1px solid var(--color-border);
  }

  .context-list div {
    display: grid;
    grid-template-columns: 5.5rem 1fr;
    gap: 1rem;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .context-list dt {
    color: var(--color-muted);
    font-size: 0.78rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .context-list dd {
    margin: 0;
    font-size: 0.92rem;
    font-weight: 650;
  }

  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
  }

  .tag-list li {
    padding: 0.24rem 0.55rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-surface-soft);
    color: var(--color-muted);
    font-size: 0.78rem;
    font-weight: 700;
  }

  .article-body {
    background: var(--color-surface);
  }

  .prose {
    width: min(100%, 46rem);
    margin-inline: auto;
    font-size: 1.06rem;
  }

  .prose :global(h2),
  .prose :global(h3) {
    margin-top: 2.5em;
  }

  .prose :global(h2) {
    font-size: clamp(1.8rem, 3.5vw, 2.5rem);
  }

  .prose :global(p),
  .prose :global(li) {
    color: #352d3a;
  }

  .prose :global(blockquote) {
    margin: 2rem 0;
    padding-left: 1.25rem;
    border-left: 3px solid var(--color-accent);
    color: var(--color-muted);
  }

  @media (max-width: 760px) {
    .article-grid {
      grid-template-columns: 1fr;
      align-items: start;
    }
  }
</style>
