---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="About"
  description="About Tessa Rouse and her interests in public administration, policy, research, and public service."
>
  <section class="page-section">
    <div class="container">
      <p class="eyebrow">About</p>
      <h1>Public service, policy, and the systems behind them.</h1>
      <p class="lede">
        This page will bring together Tessa's professional background, graduate study,
        public-service experience, and the interests that shape her work.
      </p>
      <div class="card">
        <h2>In development</h2>
        <p>
          The final biography will be written and reviewed before launch so the public
          version reflects the right balance of professional and personal context.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
