---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import WorkCard from '../../components/WorkCard.astro';

const projects = (await getCollection('projects', ({ data }) => data.public))
  .sort((a, b) => (b.data.date?.valueOf() ?? 0) - (a.data.date?.valueOf() ?? 0));

const formatDate = (date?: Date) =>
  date ? new Intl.DateTimeFormat('en-US', { year: 'numeric', month: 'short' }).format(date) : undefined;
---

<BaseLayout
  title="Projects"
  description="Selected projects and portfolio work by Tessa Rouse."
>
  <section class="page-section page-intro">
    <div class="container intro-grid">
      <div>
        <p class="eyebrow">Projects</p>
        <h1>Work beyond the page.</h1>
      </div>
      <p class="lede">
        Applied analysis, presentations, research projects, and other work that benefits
        from more context than a résumé line can provide.
      </p>
    </div>
  </section>

  <section class="page-section collection-section">
    <div class="container">
      {projects.length > 0 ? (
        <div class="collection-list">
          {projects.map((entry) => (
            <WorkCard
              href={`/projects/${entry.id}`}
              eyebrow="Project"
              title={entry.data.title}
              summary={entry.data.summary}
              meta={formatDate(entry.data.date)}
              tags={entry.data.tags}
            />
          ))}
        </div>
      ) : (
        <div class="empty-state">
          <p class="eyebrow">Collection in progress</p>
          <h2>Projects will land here next.</h2>
          <p>
            This section is ready for applied work, presentations, and portfolio projects
            once the first selections are prepared for publication.
          </p>
        </div>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .page-intro {
    padding-bottom: clamp(3rem, 6vw, 5rem);
  }

  .intro-grid {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    align-items: end;
    gap: clamp(2rem, 7vw, 7rem);
  }

  .intro-grid h1,
  .intro-grid .lede {
    margin-bottom: 0;
  }

  .collection-section {
    padding-top: 0;
    border-top: 0;
  }

  .collection-list {
    border-bottom: 1px solid var(--color-border-strong);
  }

  .empty-state {
    max-width: 46rem;
    padding: clamp(2rem, 5vw, 4rem);
    border: 1px solid var(--color-border);
    border-radius: 1.25rem;
    background: var(--color-surface);
    box-shadow: var(--shadow-soft);
  }

  .empty-state h2 {
    max-width: 12ch;
  }

  .empty-state p:last-child {
    margin-bottom: 0;
    color: var(--color-muted);
  }

  @media (max-width: 760px) {
    .intro-grid {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
  }
</style>
