---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page not found"
  description="The page you were looking for could not be found."
  noindex={true}
>
  <section class="page-section not-found">
    <div class="container not-found-grid">
      <div>
        <p class="eyebrow">404 · Page not found</p>
        <h1>This page wandered off.</h1>
        <p class="lede">
          The address may be outdated, mistyped, or no longer available. The rest of the portfolio is still right where it belongs.
        </p>
        <div class="actions">
          <a class="button" href="/">Return home</a>
          <a class="text-link" href="/writing">Browse selected work</a>
        </div>
      </div>

      <aside class="error-card" aria-label="Helpful links">
        <p class="error-code" aria-hidden="true">404</p>
        <p class="error-note">Try one of these instead:</p>
        <nav aria-label="404 page links">
          <a href="/about">About</a>
          <a href="/projects">Projects</a>
          <a href="/resume">Résumé</a>
          <a href="/contact">Contact</a>
        </nav>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    min-height: min(72vh, 46rem);
    display: grid;
    align-items: center;
  }

  .not-found-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(18rem, 0.75fr);
    align-items: center;
    gap: clamp(3rem, 8vw, 8rem);
  }

  h1 {
    max-width: 9ch;
  }

  .lede {
    max-width: 39rem;
  }

  .actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.1rem;
    margin-top: 2rem;
  }

  .error-card {
    padding: clamp(1.5rem, 4vw, 2.4rem);
    border: 1px solid var(--color-border-strong);
    border-radius: 1.25rem;
    background: color-mix(in srgb, var(--color-surface) 90%, transparent);
    box-shadow: var(--shadow-soft);
  }

  .error-code {
    margin: 0;
    color: var(--color-accent-soft);
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(5.5rem, 13vw, 9rem);
    font-weight: 600;
    line-height: 0.9;
    letter-spacing: -0.08em;
  }

  .error-note {
    margin: 1.4rem 0 0.8rem;
    color: var(--color-muted);
    font-size: 0.9rem;
    font-weight: 700;
  }

  nav {
    display: grid;
    gap: 0;
    border-top: 1px solid var(--color-border);
  }

  nav a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 3rem;
    border-bottom: 1px solid var(--color-border);
    font-weight: 750;
    text-decoration: none;
  }

  nav a::after {
    content: "→";
    transition: transform 160ms ease;
  }

  nav a:hover::after {
    transform: translateX(0.2rem);
  }

  @media (max-width: 760px) {
    .not-found {
      min-height: auto;
    }

    .not-found-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .error-card {
      width: min(100%, 32rem);
    }
  }
</style>
