---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

const { headings } = Astro.props;
const sections = headings.filter((heading) => heading.depth === 2 && heading.slug);
---

{sections.length >= 3 && (
  <nav class="article-contents" aria-label="Sections in this article">
    <details>
      <summary>
        <span class="contents-title">On this page</span>
        <span class="contents-count">{sections.length} sections · Jump to a section</span>
      </summary>
      <ol>
        {sections.map((section) => (
          <li><a href={`#${section.slug}`}>{section.text}</a></li>
        ))}
      </ol>
    </details>
  </nav>
)}

<style>
  .article-contents {
    margin: 1.7rem 0 2.5rem;
    border: 1px solid var(--color-border-strong);
    border-radius: 1rem;
    overflow: hidden;
    background: var(--color-surface-soft);
  }

  details {
    border-radius: inherit;
  }

  summary {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.3rem 1rem;
    padding: 1rem 1.2rem;
    list-style: none;
    cursor: pointer;
    border-radius: 1rem;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary::after {
    content: '+';
    margin-left: auto;
    color: var(--color-accent-dark);
    font-size: 1.45rem;
    font-weight: 400;
    line-height: 1;
  }

  details[open] > summary {
    border-radius: 1rem 1rem 0 0;
  }

  details[open] > summary::after {
    content: '−';
  }

  summary:hover {
    background: var(--color-accent-soft);
  }

  .contents-title {
    font-weight: 800;
  }

  .contents-count {
    color: var(--color-muted);
    font-size: 0.85rem;
  }

  ol {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.15rem 1.5rem;
    margin: 0;
    padding: 0.6rem 1.2rem 1.15rem 2.8rem;
    border-top: 1px solid var(--color-border);
  }

  li {
    padding: 0.25rem 0;
    color: var(--color-accent-dark);
    font-size: 0.91rem;
    line-height: 1.45;
  }

  a {
    color: var(--color-accent-dark);
    font-weight: 650;
    text-decoration: none;
  }

  a:hover {
    text-decoration: underline;
  }

  @media (max-width: 640px) {
    ol {
      grid-template-columns: 1fr;
      gap: 0.25rem;
    }

    summary {
      align-items: baseline;
    }

    .contents-count {
      flex-basis: 100%;
      order: 2;
    }
  }
</style>
