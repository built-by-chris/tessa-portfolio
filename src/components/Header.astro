---
const navItems = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/writing', label: 'Writing' },
  { href: '/projects', label: 'Projects' },
  { href: '/resume', label: 'Résumé' },
  { href: '/contact', label: 'Contact' },
];

const pathname = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? pathname === '/' : pathname === href || pathname.startsWith(`${href}/`);
---

<header class="site-header" data-menu-open="false">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label="Tessa Rouse home">
      <span class="brand-mark" aria-hidden="true">TR</span>
      <span class="brand-copy">
        <strong>Tessa Rouse</strong>
        <span>Public administration & policy</span>
      </span>
    </a>

    <button
      class="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="primary-navigation"
      aria-label="Open navigation menu"
    >
      <span class="menu-icon" aria-hidden="true">
        <span></span>
        <span></span>
        <span></span>
      </span>
    </button>

    <nav id="primary-navigation" aria-label="Primary navigation">
      <ul>
        {navItems.map((item) => (
          <li>
            <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<script>
  const mobileQuery = window.matchMedia('(max-width: 780px)');

  document.querySelectorAll('.site-header').forEach((header) => {
    const button = header.querySelector('.menu-toggle');
    const nav = header.querySelector('#primary-navigation');

    if (!(button instanceof HTMLButtonElement) || !(nav instanceof HTMLElement)) return;

    const setMenu = (open) => {
      header.setAttribute('data-menu-open', String(open));
      button.setAttribute('aria-expanded', String(open));
      button.setAttribute('aria-label', open ? 'Close navigation menu' : 'Open navigation menu');
    };

    button.addEventListener('click', () => {
      setMenu(button.getAttribute('aria-expanded') !== 'true');
    });

    document.addEventListener('click', (event) => {
      if (button.getAttribute('aria-expanded') === 'true' && event.target instanceof Node && !header.contains(event.target)) {
        setMenu(false);
      }
    });

    nav.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => setMenu(false));
    });

    header.addEventListener('focusout', (event) => {
      const next = event.relatedTarget;
      if (button.getAttribute('aria-expanded') === 'true' && next instanceof Node && !header.contains(next)) {
        setMenu(false);
      }
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && button.getAttribute('aria-expanded') === 'true') {
        setMenu(false);
        button.focus();
      }
    });

    mobileQuery.addEventListener('change', () => setMenu(false));
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid color-mix(in srgb, var(--color-border) 86%, transparent);
    background: color-mix(in srgb, var(--color-bg) 86%, transparent);
    backdrop-filter: blur(18px);
  }

  .header-inner {
    min-height: 5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    color: var(--color-text);
    text-decoration: none;
  }

  .brand-mark {
    width: 2.4rem;
    height: 2.4rem;
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    border: 1px solid var(--color-border-strong);
    border-radius: 999px;
    background: var(--color-surface);
    color: var(--color-accent-dark);
    font-family: Georgia, "Times New Roman", serif;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: -0.04em;
    box-shadow: 0 6px 18px rgba(56, 35, 68, 0.06);
  }

  .brand-copy {
    display: grid;
    line-height: 1.15;
  }

  .brand-copy strong {
    font-size: 0.96rem;
  }

  .brand-copy span {
    margin-top: 0.2rem;
    color: var(--color-muted);
    font-size: 0.72rem;
  }

  .menu-toggle {
    display: none;
    width: 2.75rem;
    height: 2.75rem;
    place-items: center;
    padding: 0;
    border: 1px solid var(--color-border-strong);
    border-radius: 0.75rem;
    background: color-mix(in srgb, var(--color-surface) 92%, transparent);
    color: var(--color-accent-dark);
    cursor: pointer;
    box-shadow: 0 6px 18px rgba(56, 35, 68, 0.05);
  }

  .menu-toggle:hover {
    background: var(--color-accent-soft);
  }

  .menu-icon {
    width: 1.15rem;
    display: grid;
    gap: 0.23rem;
  }

  .menu-icon span {
    width: 100%;
    height: 2px;
    border-radius: 999px;
    background: currentColor;
    transform-origin: center;
    transition: transform 160ms ease, opacity 160ms ease;
  }

  .site-header[data-menu-open='true'] .menu-icon span:nth-child(1) {
    transform: translateY(0.34rem) rotate(45deg);
  }

  .site-header[data-menu-open='true'] .menu-icon span:nth-child(2) {
    opacity: 0;
  }

  .site-header[data-menu-open='true'] .menu-icon span:nth-child(3) {
    transform: translateY(-0.34rem) rotate(-45deg);
  }

  ul {
    display: flex;
    align-items: center;
    gap: 0.15rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a {
    position: relative;
    display: inline-flex;
    padding: 0.55rem 0.7rem;
    border-radius: 0.6rem;
    color: var(--color-muted);
    font-size: 0.9rem;
    font-weight: 700;
    text-decoration: none;
  }

  nav a:hover {
    background: var(--color-accent-soft);
    color: var(--color-accent-dark);
  }

  nav a[aria-current='page'] {
    color: var(--color-accent-dark);
  }

  nav a[aria-current='page']::after {
    content: '';
    position: absolute;
    right: 0.7rem;
    bottom: 0.25rem;
    left: 0.7rem;
    height: 2px;
    border-radius: 999px;
    background: var(--color-accent);
  }

  @media (max-width: 780px) {
    .header-inner {
      min-height: auto;
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 0.8rem 1rem;
      padding-block: 0.85rem;
    }

    .brand {
      min-width: 0;
    }

    .menu-toggle {
      display: grid;
    }

    nav {
      display: none;
      grid-column: 1 / -1;
      width: 100%;
      padding-top: 0.65rem;
      border-top: 1px solid var(--color-border);
    }

    .site-header[data-menu-open='true'] nav {
      display: block;
    }

    ul {
      align-items: stretch;
      flex-direction: column;
      gap: 0.15rem;
    }

    nav a {
      width: 100%;
      min-height: 2.85rem;
      align-items: center;
      padding: 0.65rem 0.75rem;
    }

    nav a[aria-current='page'] {
      background: color-mix(in srgb, var(--color-accent-soft) 68%, transparent);
    }

    nav a[aria-current='page']::after {
      right: auto;
      bottom: 0.42rem;
      left: 0.75rem;
      width: 1.55rem;
    }
  }
</style>
