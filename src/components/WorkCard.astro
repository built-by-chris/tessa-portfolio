---
interface Props {
  href: string;
  eyebrow?: string;
  title: string;
  summary: string;
  meta?: string;
  tags?: string[];
}

const { href, eyebrow, title, summary, meta, tags = [] } = Astro.props;
---

<article class="work-card">
  <a class="work-link" href={href}>
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h2>{title}</h2>
    <p>{summary}</p>
    {(meta || tags.length > 0) && (
      <div class="work-meta">
        {meta && <span>{meta}</span>}
        {tags.length > 0 && (
          <ul aria-label="Topics">
            {tags.slice(0, 3).map((tag) => <li>{tag}</li>)}
          </ul>
        )}
      </div>
    )}
    <span class="read-more" aria-hidden="true">View work →</span>
  </a>
</article>

<style>
  .work-card {
    border-top: 1px solid var(--color-border-strong);
  }

  .work-link {
    display: grid;
    grid-template-columns: minmax(12rem, 0.72fr) minmax(0, 1.35fr);
    gap: 1.5rem 3rem;
    padding: 2rem 0;
    color: inherit;
    text-decoration: none;
  }

  .eyebrow {
    grid-column: 1;
    margin-bottom: 0;
  }

  h2 {
    grid-column: 1;
    margin: 0;
    font-size: clamp(1.5rem, 3vw, 2.15rem);
  }

  .work-link > p:not(.eyebrow) {
    grid-column: 2;
    grid-row: 1 / span 2;
    margin: 0;
    align-self: end;
    color: var(--color-muted);
    font-size: 1.05rem;
  }

  .work-meta {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem 1rem;
    color: var(--color-muted);
    font-size: 0.8rem;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    padding: 0.2rem 0.5rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-surface-soft);
  }

  .read-more {
    grid-column: 2;
    justify-self: end;
    color: var(--color-accent-dark);
    font-size: 0.88rem;
    font-weight: 800;
  }

  .work-link:hover h2,
  .work-link:focus-visible h2 {
    color: var(--color-accent-dark);
  }

  .work-link:focus-visible {
    border-radius: 0.45rem;
    background: var(--color-accent-soft);
  }

  @media (max-width: 680px) {
    .work-link {
      grid-template-columns: 1fr;
      gap: 0.7rem;
    }

    .eyebrow,
    h2,
    .work-link > p:not(.eyebrow),
    .work-meta,
    .read-more {
      grid-column: 1;
      grid-row: auto;
    }

    .read-more {
      justify-self: start;
      margin-top: 0.5rem;
    }
  }
</style>
