---
const examples = [
  {
    area: 'Research design',
    title: 'From research question to method',
    description:
      'Graduate exercises in case-study observation, survey measures, quasi-experimental comparisons, and critical appraisal of evidence.',
    href: '/projects/applied-research-design-public-administration',
    link: 'Explore methods project',
  },
  {
    area: 'Policy implementation',
    title: 'Administrative capacity under policy change',
    description:
      'A PACT Act analysis using managerial, legal, political, and performance perspectives to evaluate implementation tradeoffs.',
    href: '/writing/pact-act-public-administration-analysis',
    link: 'Read policy analysis',
  },
  {
    area: 'Organizational change',
    title: 'Designing for better service delivery',
    description:
      'A proposed VA care-navigation initiative mapping workflows, stakeholder input, pilot steps, and measures of success—not a deployed program.',
    href: '/projects/transgender-veterans-adaptive-leadership',
    link: 'Review intervention proposal',
  },
];
---

<div class="proof-grid">
  {examples.map((example) => (
    <article class="proof-item">
      <p class="proof-area">{example.area}</p>
      <h3>{example.title}</h3>
      <p>{example.description}</p>
      <a class="text-link" href={example.href}>{example.link}</a>
    </article>
  ))}
</div>

<style>
  .proof-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .proof-item {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: clamp(1.35rem, 3vw, 1.85rem);
    border: 1px solid var(--color-border-strong);
    border-radius: 1rem;
    background: var(--color-surface);
    box-shadow: var(--shadow-soft);
  }

  .proof-area {
    margin: 0 0 1.4rem;
    color: var(--color-accent);
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .proof-item h3 {
    margin: 0 0 0.8rem;
    font-size: clamp(1.35rem, 2.3vw, 1.65rem);
    line-height: 1.15;
  }

  .proof-item > p:not(.proof-area) {
    margin: 0 0 1rem;
    color: var(--color-muted);
    font-size: 0.95rem;
  }

  .proof-item .text-link {
    margin-top: auto;
    text-align: left;
  }

  @media (max-width: 860px) {
    .proof-grid {
      grid-template-columns: 1fr;
    }

    .proof-area {
      margin-bottom: 0.75rem;
    }
  }
</style>
