---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-inner">
    <p>© {year} Tessa Rouse.</p>
    <p>Public administration, policy analysis, research, and public service.</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border);
    color: var(--color-muted);
  }

  .footer-inner {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 2rem;
  }

  .footer-inner p {
    margin: 0;
    font-size: 0.9rem;
  }

  @media (max-width: 720px) {
    .footer-inner {
      flex-direction: column;
    }
  }
</style>
