---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-top">
    <div>
      <p class="eyebrow">Tessa Rouse</p>
      <p class="footer-statement">Policy, public administration, research, and public service.</p>
    </div>
    <a class="text-link" href="/contact">Contact</a>
  </div>
  <div class="container footer-bottom">
    <p>© {year} Tessa Rouse.</p>
    <p>Built as an evolving professional and personal portfolio.</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border);
    background: color-mix(in srgb, var(--color-bg-deep) 58%, transparent);
  }

  .footer-top,
  .footer-bottom {
    display: flex;
    justify-content: space-between;
    gap: 2rem;
  }

  .footer-top {
    align-items: flex-end;
    padding-block: 3rem;
  }

  .footer-statement {
    max-width: 32rem;
    margin: 0;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(1.4rem, 3vw, 2rem);
    line-height: 1.2;
  }

  .footer-bottom {
    padding-block: 1.25rem 2rem;
    border-top: 1px solid var(--color-border);
    color: var(--color-muted);
  }

  .footer-bottom p {
    margin: 0;
    font-size: 0.82rem;
  }

  @media (max-width: 640px) {
    .footer-top,
    .footer-bottom {
      align-items: flex-start;
      flex-direction: column;
      gap: 1rem;
    }
  }
</style>
